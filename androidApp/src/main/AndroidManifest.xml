<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- On-device analysis runs for minutes to over an hour. Without a
         foreground service the CPU is throttled once the screen is off, Doze
         suspends the work, and the process is a candidate for death under
         memory pressure. dataSync is the type that fits: local processing of
         the user's own file, started from a user action. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13+ will not show the ongoing notification without this. The
         service still runs if it is denied; only its notification is hidden. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- allowBackup is off deliberately: shared_prefs/rally.xml holds the Supabase
         session (access + refresh token), and cloud backup / device-to-device transfer
         would copy a live refresh token off the device. Nothing else in that file
         benefits from backup - the local video registry is content:// URIs that mean
         nothing on another device, and theme_mode is one enum. -->
    <application
        android:name=".RallyAndroidApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action   android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="badmintontracker" android:host="login"/>
            </intent-filter>
        </activity>

        <service
            android:name=".localanalysis.LocalAnalysisService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

    </application>
</manifest>
